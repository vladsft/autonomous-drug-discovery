# Agent Harness — local credentials and run configuration.
#
#   cp .env.example .env   &&   edit .env
#
# .env is gitignored. Never commit real secrets. This single file drives both
# `make pull/push` (host rclone) and `make cloud-run` (RunPod + the pod's rclone).

# --- Cloudflare R2 — campaign outputs + telemetry.db live here ---------------
# dash.cloudflare.com -> R2 -> create a bucket, then "Manage API Tokens".
R2_BUCKET=agent-harness
# rclone picks these up automatically as a remote named "r2" — no config file.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACL=private

# --- RunPod — the cloud GPU that runs TargetDiff -----------------------------
# runpod.io -> Settings -> API Keys (needs read/write).
RUNPOD_API_KEY=
# runpod.io -> Storage -> create a ~50 GB Network Volume; paste its ID here.
RUNPOD_NETWORK_VOLUME_ID=
# GPU model to rent. RTX 3090 is cheap (~$0.30/hr) and runs CUDA 11.7 fine.
RUNPOD_GPU_TYPE=NVIDIA GeForce RTX 3090
# Max minutes cloud_run.sh will wait for a pod's campaign to finish before
# declaring failure and tearing down. Defaults to 6h. A TargetDiff run on
# NUM=30 typically takes 30-90 min on a 3090; bigger NUM or slower GPUs need
# headroom. The pod itself enforces a slightly tighter fuse (TIMEOUT_MIN-5)
# so R2 push always has time to land before the orchestrator gives up.
RUNPOD_TIMEOUT_MIN=360

# --- Image -------------------------------------------------------------------
# The published image. Must be PUBLIC on GHCR, or the pod cannot pull it.
IMAGE=ghcr.io/vladsft/autonomous-drug-discovery:latest
