# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.Python

# =============================================================================
# Virtual environments
# =============================================================================
env/
venv/
.venv/
conda-bld/

# =============================================================================
# IDE / Editor
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# =============================================================================
# Pipeline run outputs (regenerated per campaign — do not commit)
# =============================================================================

# Telemetry database (local, regenerated on each run)
*.db
*.db.*-bak

# Per-run logs (the orchestrator's per-stage stdout/stderr drops here)
autonomous_drug_discovery/data/logs/

# Generated / intermediate molecular data
autonomous_drug_discovery/data/campaign_*/
autonomous_drug_discovery/data/candidates/
autonomous_drug_discovery/data/screened/
autonomous_drug_discovery/data/results/
autonomous_drug_discovery/data/processed/*_out/
autonomous_drug_discovery/data/processed/*_p2rank/
autonomous_drug_discovery/data/processed/*_manifest.json
autonomous_drug_discovery/data/processed/run_metadata.json

# Test run artifacts
autonomous_drug_discovery/data/test_*/

# Ad-hoc rendered figures and per-target write-ups outside the main pipeline.
# These belong to in-progress research (not yet in PR #1); tracked individually
# when they're ready, not by sweep-committing the directory.
reports/

# professor_demo.json is regenerated from telemetry every time; only the JS
# bridge (loaded by the dashboard) needs to be tracked. The JSON would
# double the dashboard-commit size for free.
dashboard/professor_demo.json

# batch_cloud_run.py drops a per-run summary in data/; ignored because every
# new batch invalidates the previous one.
data/batch_summary.json

# Molecular structure files (large, binary, regenerated)
*.pdbqt
*.sdf
*.pqr

# Keep input PDB files tracked (small, needed to reproduce)
!autonomous_drug_discovery/data/processed/*.pdb

# =============================================================================
# Large reference data (download separately — see README)
# =============================================================================
data/components.cif.gz
data/aa-variants-v1.cif
data/sample/
data/.idea/
data/._*

# =============================================================================
# Model checkpoints / weights (too large for git)
# =============================================================================
*.pt
*.ckpt
*.h5
*.safetensors
*.bin

# =============================================================================
# Secrets / credentials
# =============================================================================
.env
*.key
*.secret
credentials.json

# =============================================================================
# SQLite WAL/SHM files
# =============================================================================
*.db-shm
*.db-wal

# =============================================================================
# Pytest
# =============================================================================
.pytest_cache/

# =============================================================================
# Session-specific / external documents
# =============================================================================
AGENT_HANDOFF.md
compass_artifact_*.md
